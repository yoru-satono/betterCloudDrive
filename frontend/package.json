{
  "name": "betterclouddrive-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "check:i18n": "node scripts/check-i18n-hardcoding.mjs",
    "dev": "vite",
    "build": "pnpm run check:i18n && vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "pnpm run check:i18n && vitest run",
    "test:coverage": "pnpm run check:i18n && vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:docker": "node scripts/run-playwright-docker.mjs",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "tauri:e2e:build": "tauri build --no-bundle",
    "test:e2e:tauri": "node scripts/run-tauri-e2e.mjs",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@types/spark-md5": "^3.0.5",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^14.3.0",
    "axios": "^1.18.1",
    "@lucide/vue": "^1.27.0",
    "pinia": "^4.0.2",
    "spark-md5": "^3.0.2",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.40",
    "vue-i18n": "^11.4.7",
    "vue-router": "^5.2.0",
    "vue-sonner": "^2.0.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@vue/compiler-dom": "^3.5.40",
    "@vue/compiler-sfc": "^3.5.40",
    "@playwright/test": "^1.62.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.12.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "4.1.10",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "@wdio/cli": "^9.28.0",
    "@wdio/globals": "^9.28.0",
    "@wdio/local-runner": "^9.28.0",
    "@wdio/mocha-framework": "^9.28.0",
    "@wdio/spec-reporter": "^9.28.0",
    "edgedriver": "^6.3.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8",
    "webdriverio": "^9.30.0"
  }
}

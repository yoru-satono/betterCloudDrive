{
  "extends": "../frontend/tsconfig.app.json",
  "compilerOptions": {
    "baseUrl": ".",
    "types": ["../frontend/node_modules/vite/client"],
    "tsBuildInfoFile": "../frontend/node_modules/.tmp/desktop.tsbuildinfo",
    "paths": {
      "@/config/runtime": ["web/runtime.ts"],
      "@/api/client": ["web/client.ts"],
      "@/stores/auth": ["web/auth.ts"],
      "@/stores/preview": ["web/preview.ts"],
      "@/components/file/OnlyOfficeEditor.vue": ["web/components/OnlyOfficeEditor.vue"],
      "@tauri-apps/api/core": ["web/bridge.ts"],
      "@tauri-apps/api/event": ["web/bridge.ts"],
      "@tauri-apps/api/window": ["web/bridge.ts"],
      "@tauri-apps/api/app": ["web/bridge.ts"],
      "@/*": ["../frontend/src/*"],
      "spark-md5": ["../frontend/node_modules/@types/spark-md5"],
      "*": ["../frontend/node_modules/*"]
    }
  },
  "include": ["web/**/*.ts", "web/**/*.vue", "../frontend/src/**/*.vue", "../frontend/src/**/*.ts"]
}

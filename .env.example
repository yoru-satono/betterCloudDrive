# Docker Compose host ports. Service runtime variables live in config/env-files/*.env.
HOST_POSTGRES_PORT=5432
HOST_REDIS_PORT=6379
HOST_RABBITMQ_PORT=5672
HOST_RABBITMQ_MANAGEMENT_PORT=15672
HOST_SEAWEEDFS_S3_PORT=8333
HOST_SEAWEEDFS_WEBDAV_PORT=8888
HOST_SEAWEEDFS_MASTER_PORT=9333
HOST_MAILPIT_SMTP_PORT=1025
HOST_MAILPIT_UI_PORT=8025
HOST_LOKI_PORT=3100
HOST_PROMETHEUS_PORT=9090
HOST_ALERTMANAGER_PORT=9093
HOST_MANAGEMENT_PORT=8081
HOST_ALLOY_PORT=12345
HOST_BACKEND_PORT=8080
HOST_FRONTEND_PORT=3000
APP_PUBLIC_URL=http://localhost:3000
MAIL_FROM=noreply@betterclouddrive.local
HOST_ONLYOFFICE_PORT=8082
POSTGRES_LOG_MIN_DURATION_MS=500
ALERTMANAGER_CONFIG_FILE=./observability/alertmanager.yml
ALERTMANAGER_PRODUCTION_CONFIG_FILE=./observability/alertmanager-production.yml
ALERTMANAGER_RETENTION_TIME=72h
PROMETHEUS_ENVIRONMENT=development
TRUSTED_PROXY_CIDRS=172.16.0.0/12
DRIVE_RATE_LIMIT_DEFAULT_PERMITS=300
DRIVE_RATE_LIMIT_DEFAULT_PERIOD_SECONDS=60
DRIVE_RATE_LIMIT_AUTH_PERMITS=30
DRIVE_RATE_LIMIT_AUTH_PERIOD_SECONDS=60
DRIVE_RATE_LIMIT_UPLOAD_PERMITS=120
DRIVE_RATE_LIMIT_UPLOAD_PERIOD_SECONDS=60
DRIVE_RATE_LIMIT_UPLOAD_CHUNK_PERMITS=600
DRIVE_RATE_LIMIT_UPLOAD_CHUNK_PERIOD_SECONDS=60

# Shared by Docker Compose and backend.env. Replace in non-local deployments.
ONLYOFFICE_JWT_SECRET=betterclouddrive-onlyoffice-dev-secret

# Frontend Docker build args.
VITE_API_BASE_URL=
VITE_WEB_BASE_URL=
VITE_DESKTOP_API_BASE_URL=http://127.0.0.1:8080/api/v1
VITE_DESKTOP_WEB_BASE_URL=http://127.0.0.1:3000

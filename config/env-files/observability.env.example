# Observability
GRAFANA_BASE_URL=/grafana
GRAFANA_AUTH_PROXY_SECRET=replace_with_random_grafana_auth_proxy_secret
GRAFANA_AUTH_PROXY_TTL_SECONDS=300
GRAFANA_AUTH_COOKIE_SECURE=false
GRAFANA_INTERNAL_URL=http://grafana:3000
GRAFANA_LOCALE_SYNC_ENABLED=true
GRAFANA_LOCALE_SYNC_TIMEOUT_MS=2000
GF_SERVER_ROOT_URL=%(protocol)s://%(domain)s:%(http_port)s/grafana/
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
GRAFANA_LOKI_DATASOURCE=Loki
GRAFANA_DS_LOKI_URL=http://loki:3100
GRAFANA_DS_PROMETHEUS_URL=http://prometheus:9090
GRAFANA_DS_ALERTMANAGER_URL=http://alertmanager:9093
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_ENVIRONMENT=development
ALERTMANAGER_RETENTION_TIME=72h
LOKI_RETENTION_PERIOD=14d
LOKI_PORT=3100
LOKI_BASE_URL=http://loki:3100
METRICS_EXPORT_OTLP_ENABLED=false
TRACING_ENABLED=true
TRACING_SAMPLING_PROBABILITY=0.1
TRACING_EXPORT_OTLP_ENABLED=false
ALLOY_LOKI_PUSH_URL=http://loki:3100/loki/api/v1/push
MANAGEMENT_SERVER_PORT=8081
SYSTEM_LOG_DEFAULT_LIMIT=100
SYSTEM_LOG_MAX_LIMIT=500
AUDIT_LOG_ENABLED=true
AUDIT_EVENT_ENABLED=true
AUDIT_CAPTURE_BODY=false
AUDIT_MAX_BODY_BYTES=8192
OBSERVABILITY_TRUSTED_PROXY_CIDRS=

# Copy to warehouse.env. Generate independent random values; never overwrite an existing local file.
WAREHOUSE_SOURCE_DSN=postgresql://warehouse_exporter:REPLACE_EXPORTER_PASSWORD@postgres:5432/better_cloud_drive
WAREHOUSE_SOURCE_ZONE=UTC
WAREHOUSE_CLICKHOUSE_HOST=clickhouse
WAREHOUSE_CLICKHOUSE_PORT=8123
WAREHOUSE_CLICKHOUSE_DATABASE=bcd_warehouse
WAREHOUSE_CLICKHOUSE_USER=warehouse_writer
WAREHOUSE_CLICKHOUSE_PASSWORD=REPLACE_WRITER_PASSWORD
WAREHOUSE_BATCH_SIZE=1000
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://warehouse_airflow:REPLACE_AIRFLOW_DATABASE_PASSWORD@warehouse-airflow-postgres:5432/warehouse_airflow
AIRFLOW__CORE__FERNET_KEY=REPLACE_GENERATED_FERNET_KEY
AIRFLOW__API_AUTH__JWT_SECRET=REPLACE_RANDOM_JWT_SECRET
WAREHOUSE_AIRFLOW_ADMIN_PASSWORD=REPLACE_RANDOM_LOCAL_AIRFLOW_PASSWORD

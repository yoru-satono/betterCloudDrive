# Privileged credentials are mounted only in the one-shot bootstrap service.
WAREHOUSE_BOOTSTRAP_SOURCE_DSN=postgresql://REPLACE_SOURCE_ADMIN_USER:REPLACE_SOURCE_ADMIN_PASSWORD@postgres:5432/better_cloud_drive
WAREHOUSE_EXPORTER_PASSWORD=REPLACE_EXPORTER_PASSWORD
WAREHOUSE_CLICKHOUSE_HOST=clickhouse
WAREHOUSE_CLICKHOUSE_ADMIN_PASSWORD=REPLACE_CLICKHOUSE_ADMIN_PASSWORD
WAREHOUSE_WRITER_PASSWORD=REPLACE_WRITER_PASSWORD
WAREHOUSE_READER_PASSWORD=REPLACE_READER_PASSWORD

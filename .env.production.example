# Copy to an ignored .env.production file and replace every example value.
# Docker Compose host bindings remain loopback-only in docker-compose.production.yml.
HOST_FRONTEND_PORT=3000
HOST_ONLYOFFICE_PORT=8082

# Public HTTPS origins served by the host Caddy instance.
BCD_PUBLIC_DOMAIN=drive.example.com
BCD_ONLYOFFICE_DOMAIN=office.example.com
APP_PUBLIC_URL=https://drive.example.com
ONLYOFFICE_PUBLIC_URL=https://office.example.com

# Must match the value used by the backend and OnlyOffice Document Server.
ONLYOFFICE_JWT_SECRET=replace_with_a_long_random_secret

# Rate limiting and the proxies allowed to supply forwarding headers.
TRUSTED_PROXY_CIDRS=172.16.0.0/12
DRIVE_RATE_LIMIT_DEFAULT_PERMITS=300
DRIVE_RATE_LIMIT_DEFAULT_PERIOD_SECONDS=60
DRIVE_RATE_LIMIT_AUTH_PERMITS=30
DRIVE_RATE_LIMIT_AUTH_PERIOD_SECONDS=60
DRIVE_RATE_LIMIT_UPLOAD_PERMITS=120
DRIVE_RATE_LIMIT_UPLOAD_PERIOD_SECONDS=60
DRIVE_RATE_LIMIT_UPLOAD_CHUNK_PERMITS=600
DRIVE_RATE_LIMIT_UPLOAD_CHUNK_PERIOD_SECONDS=60

# Production observability overlay.
PROMETHEUS_ENVIRONMENT=production
ALERTMANAGER_PRODUCTION_CONFIG_FILE=/etc/betterclouddrive/alertmanager.yml
